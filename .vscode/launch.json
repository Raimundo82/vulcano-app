{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Flask",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1",
                "FLASK_ENV": "development"
            },
            "args": [
                "--app",
                "vulcano_app.app",
                "run",
                "--debug"
            ],
            "jinja": true,
            "autoStartBrowser": false
        },
    ]
}
